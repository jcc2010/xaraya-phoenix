{{ render('blog::admin/flash', {flash: flash}) }}
<h1>{{ t('Settings') }} <small>{{ blog.title }}</small></h1>
{% if formErrors is not empty %}
<div class="form-error" role="alert"><ul>
{% for message in formErrors %}
<li>{{ message }}</li>
{% endfor %}
</ul></div>
{% endif %}
<p class="admin-mode">{{ t('Mode: {mode}. Change it with', {mode: blog.mode}) }} <code>bin/xar blog:mode {{ blog.handle }} mirror|native</code>.</p>
{% if mirror %}
<p class="form-notice">{{ t('The source supplies the title, description, author and language; a sync overwrites them, so they cannot be edited here.') }}</p>
{% endif %}
<form class="admin-form" method="post" action="{{ action }}">
{{ csrf() }}
<p class="admin-field">
<label for="blog-title">{{ t('Title') }}</label>
<input id="blog-title" name="title" value="{{ values.title }}"{% if errors.title is defined %} aria-invalid="true" aria-describedby="blog-title-error"{% endif %}{% if mirror and 'title' in synced %} disabled{% endif %}>
{{ render('blog::admin/field-error', {id: 'blog-title', error: errors.title ?? null}) }}
</p>
<p class="admin-field">
<label for="blog-description-html">{{ t('Description (HTML)') }}</label>
<textarea id="blog-description-html" name="description_html" rows="6"{% if errors.description_html is defined %} aria-invalid="true" aria-describedby="blog-description-html-error"{% endif %}{% if mirror and 'description_html' in synced %} disabled{% endif %}>{{ values.description_html }}</textarea>
{{ render('blog::admin/field-error', {id: 'blog-description-html', error: errors.description_html ?? null}) }}
</p>
<p class="admin-field">
<label for="blog-author-name">{{ t('Author name') }}</label>
<input id="blog-author-name" name="author_name" value="{{ values.author_name }}"{% if errors.author_name is defined %} aria-invalid="true" aria-describedby="blog-author-name-error"{% endif %}{% if mirror and 'author_name' in synced %} disabled{% endif %}>
{{ render('blog::admin/field-error', {id: 'blog-author-name', error: errors.author_name ?? null}) }}
</p>
<p class="admin-field">
<label for="blog-author-url">{{ t('Author URL') }}</label>
<input id="blog-author-url" name="author_url" value="{{ values.author_url }}"{% if errors.author_url is defined %} aria-invalid="true" aria-describedby="blog-author-url-error"{% endif %}{% if mirror and 'author_url' in synced %} disabled{% endif %}>
{{ render('blog::admin/field-error', {id: 'blog-author-url', error: errors.author_url ?? null}) }}
</p>
<p class="admin-field">
<label for="blog-language">{{ t('Language') }}</label>
<input id="blog-language" name="language" value="{{ values.language }}"{% if errors.language is defined %} aria-invalid="true" aria-describedby="blog-language-error"{% endif %}{% if mirror and 'language' in synced %} disabled{% endif %}>
{{ render('blog::admin/field-error', {id: 'blog-language', error: errors.language ?? null}) }}
</p>
<p class="admin-field">
<label for="blog-post-url-pattern">{{ t('Post URL pattern') }}</label>
<input id="blog-post-url-pattern" name="post_url_pattern" value="{{ values.post_url_pattern }}"{% if errors.post_url_pattern is defined %} aria-invalid="true" aria-describedby="blog-post-url-pattern-error"{% endif %}>
{{ render('blog::admin/field-error', {id: 'blog-post-url-pattern', error: errors.post_url_pattern ?? null}) }}
</p>
<p class="admin-field">
<label for="blog-media">{{ t('Media') }}</label>
<select id="blog-media" name="media"{% if errors.media is defined %} aria-invalid="true" aria-describedby="blog-media-error"{% endif %}>
{% for m in media %}
<option value="{{ m }}"{% if m == values.media %} selected{% endif %}>{{ m }}</option>
{% endfor %}
</select>
{{ render('blog::admin/field-error', {id: 'blog-media', error: errors.media ?? null}) }}
</p>
<p class="admin-buttons"><button type="submit">{{ t('Save') }}</button> <a href="{{ backUrl }}">{{ t('Back to posts') }}</a></p>
</form>
