<p class="post-video"><a class="video-link" href="{{ video.watchUrl }}" rel="nofollow noopener">{% if video.thumbnail is not null %}<img src="{{ video.thumbnail }}" alt="" loading="lazy" referrerpolicy="no-referrer">{% endif %}<span class="video-play" aria-hidden="true">▶</span><span class="visually-hidden">{{ t('Watch the video') }}</span></a></p>
